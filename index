/* ---------------- evaluation ---------------- */
function snapToMembrane(pose){
  for(let r=2;r<=10;r+=2) for(let k=0;k<16;k++){
    const t=k*Math.PI/8, x=pose.x+r*Math.cos(t), y=pose.y+r*Math.sin(t), reg=regionAt(x,y);
