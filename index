  }
  return null;
}
function firstExit(x,y,dx,dy,mem){
  for(let t=1;t<=16;t+=1){ const r=regionAt(x+dx*t,y+dy*t); if(r!==mem) return r; }
  return null;
}
function evaluate(c,fromCheck){
  const pose=S.poses[c.id];
  let r=regionAt(pose.x,pose.y);
  if(c.orient && !MEMBRANES.includes(r)){ const s=snapToMembrane(pose); if(s) r=s; }
  if(!c.orient && lastThin){ const n=compartmentNear(pose); if(n) r=n; }
  if(r!==c.answer){ locationMiss(c,r); afterChange(); return; }
  if(!c.orient){ succeed(c); afterChange(); return; }
  const rad=pose.a*Math.PI/180, dx=-Math.sin(rad), dy=Math.cos(rad);
  const plus=firstExit(pose.x,pose.y,dx,dy,c.answer), minus=firstExit(pose.x,pose.y,-dx,-dy,c.answer);
  const ok = plus===c.orient.plus && c.orient.minus.includes(minus);
  if(!fromCheck){
    say("info",`Right membrane. Now make sure Card ${c.letter} faces the right way: drag the ↻ handle or use the rotate buttons, then press <b>Check orientation</b>.`);
    afterChange(); return;
  }
  if(ok){ succeed(c); afterChange(); return; }
  const flipped = c.orient.minus.includes(plus) && minus===c.orient.plus;
  const n=(S.omisses[c.id]||0)+1; S.omisses[c.id]=n;
  if(n>=3) reveal(c,"orientation");
  else if(n===2) say("warn","Not facing the right way yet.",c.orientHint2);
  else say("warn", flipped? c.flipHint : c.edgeHint);
  afterChange();
}
function locationMiss(c,r){
  const n=(S.misses[c.id]||0)+1; S.misses[c.id]=n;
  const where = r? `Not the ${REGIONS[r].name.toLowerCase()}.` : "That's outside the cell.";
  if(n>=3){ reveal(c,"location"); return; }
  if(n===2){ say("warn",where,c.hint2); return; }
  say("warn",where,(r&&c.hints[r]) || (MEMBRANES.includes(r)&&c.memHint) || GENERIC_HINT);
}
function succeed(c){
  S.placed[c.id]=true; boardSel=null;
  say("ok", c.ok + (c.needsName&&!S.named[c.id]? " Don't forget to name it on the card at right." : ""));
}
function reveal(c){
  S.poses[c.id]={...c.reveal}; S.placed[c.id]=true; S.revealed.push(c.id); boardSel=null;
  say("warn",`Here's where Card ${c.letter} goes. I've placed it for you.`, c.ok.replace(/^Yes\. /,""));
}
function checkName(c,val){
  if(!val) return;
  if(val===c.name){ S.named[c.id]=true; say("ok",`Yes. Card ${c.letter} is ${NAME_SAY[c.name]}.`); }
  else{
    const n=(S.nameMisses[c.id]||0)+1; S.nameMisses[c.id]=n;
    if(n>=3){ S.named[c.id]=true; say("warn",`Card ${c.letter} is ${NAME_SAY[c.name]}.`,c.nameHint); }
    else say("warn",`Card ${c.letter} isn't ${NAME_SAY[val]}.`,c.nameHint);
    $("name-"+c.id).value="";
  }
  afterChange();
}

/* ---------------- toolbar ---------------- */
function toolsHint(c){
  if(c.orient) say("",`Card ${c.letter} selected. Drag it to move, drag the ↻ handle to rotate, then press <b>Check orientation</b>.`);
  else say("",`Card ${c.letter} selected. Drag it to move it.`);
}
function refreshTools(){
  const t=$("tools"), c=boardSel&&card(boardSel);
  t.classList.toggle("hidden",!c);
  if(!c) return;
  $("toolsLabel").textContent=`Card ${c.letter}`;
  $("tCheck").classList.toggle("hidden",!c.orient);
}
$("tLeft").addEventListener("click",()=>rotateBy(-15));
$("tRight").addEventListener("click",()=>rotateBy(15));
$("tFlip").addEventListener("click",()=>rotateBy(180));
$("tCheck").addEventListener("click",()=>{ if(boardSel) evaluate(card(boardSel),true); });
$("tBack").addEventListener("click",()=>{ if(!boardSel) return; delete S.poses[boardSel]; boardSel=null; say("","Card returned to the tray."); afterChange(); });
document.addEventListener("keydown",e=>{
  if(e.key==="Escape"){ ["zoomOv","doneOv","bonusOv"].forEach(id=>$(id).classList.add("hidden")); if(boardSel||traySel){ boardSel=null; traySel=null; refresh(); } return; }
  if(!boardSel || /INPUT|SELECT|TEXTAREA/.test(document.activeElement.tagName)) return;
  const p=S.poses[boardSel];
  if(e.key==="r"){ rotateBy(15); } else if(e.key==="R"){ rotateBy(-15); }
  else if(e.key.startsWith("Arrow")){ e.preventDefault(); const d=e.shiftKey?10:2;
    if(e.key==="ArrowLeft") p.x-=d; if(e.key==="ArrowRight") p.x+=d; if(e.key==="ArrowUp") p.y-=d; if(e.key==="ArrowDown") p.y+=d; drawBoard(); }
  else if(e.key==="Enter"){ evaluate(card(boardSel),true); }
});

/* ---------------- tooltip ---------------- */
const tip=$("tip");
svg.addEventListener("pointermove",e=>{
  if(dragging) return;
  const t=e.target.closest && e.target.closest(".rg");
  if(t){ tip.textContent=REGIONS[t.dataset.region].name; tip.classList.remove("hidden"); tip.style.left=(e.clientX+14)+"px"; tip.style.top=(e.clientY+14)+"px"; }
  else tip.classList.add("hidden");
});
svg.addEventListener("pointerleave",()=>{ if(!dragging) tip.classList.add("hidden"); });

/* ---------------- post-it ---------------- */
function toggleHighlight(r){
  if(S.hlDone){ say("",`${REGIONS[r].name}.`); return; }
  const i=S.highlights.indexOf(r); if(i>=0) S.highlights.splice(i,1); else S.highlights.push(r);
  setHighlights(); save(); say("",`${REGIONS[r].name}: ${S.highlights.includes(r)?"shaded":"unshaded"}.`);
}
function setHighlights(){ document.querySelectorAll(".rg").forEach(e=>e.classList.toggle("hl", !!S && S.highlights.includes(e.dataset.region))); }
function checkHighlights(){
  const F=FEATURES[S.feature], sel=S.highlights, accepted=new Set(F.groups.flat());
  const missing=F.groups.map((g,i)=>g.some(r=>sel.includes(r))?null:i).filter(i=>i!==null);
  const extras=sel.filter(r=>!accepted.has(r));
  S.hlAttempts++;
  if(!missing.length && !extras.length){ S.hlDone=true; S.finishedAt=Date.now(); say("ok","That's it.",F.ok); afterChange(); showDone(); return; }
  if(S.hlAttempts>=3){ S.highlights=[...new Set(F.groups.map(g=>g[0]))]; S.hlDone=true; S.finishedAt=Date.now();
    say("warn","Here's the answer, now shaded on the cell.",F.ok); afterChange(); showDone(); return; }
  const lines=[];
  extras.forEach(r=>lines.push(`${REGIONS[r].name}: ${F.extra[r]||"this region doesn't fit your mission."}`));
  missing.forEach(i=>lines.push(F.groupMiss[i]));
  say("warn",(extras.length&&missing.length)?"Some shading is off, and some is missing.":(extras.length?"Remove what doesn't fit.":"You're on track but missing something."),...lines);
  afterChange();
}

/* ---------------- phases & refresh ---------------- */
function allPlaced(){ return CARDS.every(c=>S.placed[c.id]); }
function allNamed(){ return CARDS.every(c=>!c.needsName||S.named[c.id]); }
function phase(){ if(!S) return 0; if(!allPlaced()) return 1; if(!allNamed()) return 2; return 3; }
function say(kind,...lines){ const f=$("feedback"); f.className="feedback"+(kind&&kind!=="info"?" "+kind:""); f.innerHTML=lines.map(l=>`<p>${l}</p>`).join(""); }
function refresh(){ refreshTray(); drawBoard(); refreshTools(); }
let postitIntroShown=false;
function afterChange(){
  refresh(); updatePhaseUI(); setHighlights();
  if(phase()===3 && !S.hlDone && !postitIntroShown){ postitIntroShown=true; say("","All processes placed and named. Mission unlocked: check the panel on the right."); }
  save();
}
function updatePhaseUI(){
  const p=phase();
  const np=CARDS.filter(c=>S.placed[c.id]).length, nn=CARDS.filter(c=>S.named[c.id]).length;
  $("st1").textContent=`Place ${np}/5`; $("st2").textContent=`Name ${nn}/5`;
  $("st1").className=allPlaced()?"done":"now";
  $("st2").className=allNamed()?"done":"now";
  $("st3").className=S.hlDone?"done":(p===3?"now":"");
  const inPostit=p===3;
  $("boardHint").textContent = inPostit ? (S.hlDone?"Board complete.":"Mission: tap each part of the cell that fits, to shade it blue.")
    : (allPlaced()?"All placed. Finish naming the cards on the right.":"Drag each card onto the cell where that process happens. Membrane processes also need to face the right way.");
  $("postitPanel").classList.toggle("hidden",!inPostit);
  $("placePanel").classList.toggle("hidden",inPostit);
  $("tray").classList.toggle("hidden",inPostit);
  $("checkHl").disabled=S.hlDone; $("clearHl").disabled=S.hlDone;
  $("bonusBtn").classList.toggle("hidden",!S.hlDone); if(S.hlDone) refreshBonus();
  if(inPostit){ const F=FEATURES[S.feature];
    $("stickyText").innerHTML=`<span class="mlabel">Mission: ${FEATURE_LABEL[S.feature]}</span>${F.text}${F.sub?`<small>${F.sub}</small>`:""}`; }
}
function totalMisses(s){ const sum=o=>Object.values(o||{}).reduce((a,b)=>a+b,0);
  return sum(s.misses)+sum(s.omisses)+sum(s.nameMisses)+(s.hlDone?Math.max(0,s.hlAttempts-1):s.hlAttempts); }
function showDone(){
  const m=totalMisses(S);
  $("doneText").textContent=`${S.group} finished in ${fmt(S.finishedAt-S.startedAt)} with ${m} ${m===1?"miss":"misses"} along the way.`;
  $("doneOv").classList.remove("hidden");
}

/* ---------------- timer ---------------- */
function fmt(ms){ const s=Math.max(0,Math.floor(ms/1000)); return `${Math.floor(s/60)}:${String(s%60).padStart(2,"0")}`; }
setInterval(()=>{ if(!S) return; const ms=(S.finishedAt||Date.now())-S.startedAt; $("timer").textContent=fmt(ms); $("timer").classList.toggle("late",ms>5*60*1000&&!S.finishedAt); },1000);

/* ---------------- start screen ---------------- */
function buildStart(){
  SECTIONS.forEach(([v,l])=>{ $("secSel").add(new Option(l,v)); $("dashSec").add(new Option(l,v)); });
  FEATURE_ORDER.forEach(f=>$("featSel").add(new Option(FEATURE_LABEL[f],f)));
  $("featSel").value=FEATURE_ORDER[Math.floor(Math.random()*FEATURE_ORDER.length)];
  let rt=null; $("grpIn").addEventListener("input",()=>{ clearTimeout(rt); rt=setTimeout(checkResume,350); });
  $("secSel").addEventListener("change",checkResume);
}
async function checkResume(){
  if(!slug($("grpIn").value)){ $("resumeNote").textContent=""; return; }
  const prev=await load($("secSel").value,$("grpIn").value);
  $("resumeNote").textContent=prev?"This group already started. You'll pick up where you left off.":"";
}
$("startBtn").addEventListener("click",async()=>{
  const sec=$("secSel").value, g=$("grpIn").value.trim(), f=$("featSel").value;
  if(!slug(g)){ $("resumeNote").textContent="Enter a group name to start."; $("grpIn").focus(); return; }
  const prev=await load(sec,g);
  S=prev||freshState(sec,g,f); S.feature=f; S.poses=S.poses||{}; S.omisses=S.omisses||{};
  $("who").innerHTML=`<b>${esc(g)}</b> · ${SECTIONS.find(x=>x[0]===sec)[1].split(" · ")[0]}`;
  $("startOv").classList.add("hidden");
  if(prev && phase()===3) postitIntroShown=true;
  afterChange();
});
$("checkHl").addEventListener("click",checkHighlights);
$("clearHl").addEventListener("click",()=>{ S.highlights=[]; setHighlights(); save(); });
$("zoomClose").addEventListener("click",()=>$("zoomOv").classList.add("hidden"));
$("doneClose").addEventListener("click",()=>$("doneOv").classList.add("hidden"));

/* ---------------- instructor dashboard ---------------- */
let dashTimer=null;
$("openDash").addEventListener("click",()=>{ $("dashOv").classList.remove("hidden"); if(S) $("dashSec").value=S.section; refreshDash(); dashTimer=setInterval(refreshDash,8000); });
$("dashClose").addEventListener("click",()=>{ $("dashOv").classList.add("hidden"); clearInterval(dashTimer); });
$("dashSec").addEventListener("change",refreshDash);
$("dashClear").addEventListener("click",async()=>{
  if(!hasStore()) return;
  let pin="";
  if(BACKEND==="sheets"){ pin=prompt("Enter your instructor PIN to delete this section's rows from the Google Sheet:"); if(pin===null) return; }
  else if(!confirm("Delete all saved progress for this section? Groups still playing will keep their current screen but lose their saved progress.")) return;
  try{ await storeClear($("dashSec").value,pin); }catch(e){ alert(String(e.message).includes("pin")?"That PIN didn't match. Nothing was deleted.":"Couldn't clear the data: "+e.message); }
  refreshDash();
});
async function refreshDash(){
  const body=$("dashBody");
  if(!hasStore()){ body.innerHTML=`<p class="fine">Progress tracking isn't set up yet. Paste your Google Apps Script web app URL into <code>SHEETS_URL</code> near the top of the file's script.</p>`; return; }
  const sec=$("dashSec").value; let rows=[];
  try{ rows=await storeList(sec); }
  catch(e){ body.innerHTML=`<p class="fine">Couldn't load progress. It will retry in a few seconds.</p>`; return; }
  $("dashStamp").textContent="Updated "+new Date().toLocaleTimeString([],{hour:"numeric",minute:"2-digit",second:"2-digit"});
  if(!rows.length){ body.innerHTML=`<p class="fine">No groups have started in this section yet.</p>`; return; }
  rows.sort((a,b)=>String(a.group).localeCompare(String(b.group),undefined,{numeric:true}));
  const miss={}; const add=(k,v)=>{ if(v) miss[k]=(miss[k]||0)+v; };
  const trs=rows.map(s=>{
    const placed=CARDS.filter(c=>s.placed[c.id]).length, named=CARDS.filter(c=>c.needsName&&s.named[c.id]).length;
    CARDS.forEach(c=>{ add(`Placing card ${c.letter} (${c.short})`,(s.misses||{})[c.id]); add(`Orienting card ${c.letter} (${c.short})`,(s.omisses||{})[c.id]); add(`Naming card ${c.letter} (${c.short})`,(s.nameMisses||{})[c.id]); });
    add("Mission: "+FEATURE_LABEL[s.feature], s.hlDone?s.hlAttempts-1:s.hlAttempts);
    if(s.bonus) MOLS.forEach(m=>add(`Bonus: molecule ${MOLS.indexOf(m)+1} (${m.answer.replace(/ \(G3P\)/,"")})`,s.bonus.misses[m.id]));
    const pct=Math.round(((placed+named+(s.hlDone?1:0))/11)*100), ago=Math.round((Date.now()-s.updatedAt)/1000);
    return `<tr><td><b>${esc(s.group)}</b></td><td><div class="bar"><i style="width:${pct}%"></i></div></td>
      <td>${placed}/5</td><td>${named}/5</td><td>${FEATURE_LABEL[s.feature]} ${s.hlDone?'<span class="pill ok">done</span>':(placed===5&&named===5?'<span class="pill">working</span>':"")}</td>
      <td>${s.bonus? MOLS.filter(m=>s.bonus.named[m.id]).length+"/4" : '<span class="fine">—</span>'}</td>
      <td>${totalMisses(s)}${s.revealed&&s.revealed.length?` <span class="fine">(${s.revealed.length} revealed)</span>`:""}</td>
      <td>${fmt((s.finishedAt||Date.now())-s.startedAt)}</td><td class="fine">${ago<60?ago+"s ago":Math.round(ago/60)+" min ago"}</td></tr>`;
  }).join("");
  const top=Object.entries(miss).sort((a,b)=>b[1]-a[1]).slice(0,4);
  body.innerHTML=`<table><thead><tr><th>Group</th><th>Progress</th><th>Placed</th><th>Named</th><th>Mission</th><th>Bonus</th><th>Misses</th><th>Time</th><th>Last move</th></tr></thead><tbody>${trs}</tbody></table>
    ${top.length?`<h3 style="margin:18px 0 0;font-size:1.05rem">Most missed so far</h3><ol class="trouble">${top.map(([k,v])=>`<li>${k}: ${v}</li>`).join("")}</ol>`:""}`;
}

/* ---------------- init ---------------- */
buildCell(); buildTray(); buildStart();
/* ---------------- bonus: name the molecules ---------------- */
const MOL_OPTIONS = ["Glucose","Glyceraldehyde-3-phosphate (G3P)","3-Phosphoglycerate","Pyruvate","Lactate","Acetyl-CoA","Oxaloacetate"];
const MOLS = [
  { id:"g3p", img:"m_g3p", answer:"Glyceraldehyde-3-phosphate (G3P)",
    ok:"Yes. G3P is the 3-carbon sugar the Calvin cycle exports, and glycolysis splits glucose into two of them.",
    specific:{ "3-Phosphoglycerate":"Close. 3-Phosphoglycerate has a carboxylate (O⁻–C=O) at the top. This one has an aldehyde (H–C=O)." },
    hint1:"Count the carbons, then look at the top carbon: is it an aldehyde (H–C=O) or a carboxylate (O⁻–C=O)?",
    hint2:"Three carbons, an aldehyde, and a phosphate. It's the product the Calvin cycle exports." },
  { id:"acoa", img:"m_acoa", answer:"Acetyl-CoA",
    ok:"Yes. Acetyl-CoA carries a 2-carbon acetyl group into the citric acid cycle.",
    specific:{ "Oxaloacetate":"Oxaloacetate has four carbons and no CoA. Count the carbons attached to CoA here." },
    hint1:"How many carbons are attached to the CoA?",
    hint2:"A 2-carbon acetyl group carried by coenzyme A. It's made when pyruvate is oxidized." },
  { id:"glc", img:"m_glc", answer:"Glucose",
    ok:"Yes. Glucose is the 6-carbon sugar built from CO₂ in photosynthesis and broken down in cellular respiration.",
    specific:{},
    hint1:"Count the carbons in the ring plus the CH₂OH. How many are there, and is there a phosphate?",
    hint2:"A 6-carbon sugar with no phosphate. It's the starting molecule of glycolysis." },
  { id:"pyr", img:"m_pyr", answer:"Pyruvate",
    ok:"Yes. Pyruvate is the 3-carbon end product of glycolysis.",
    specific:{ "Lactate":"Lactate has an OH on the middle carbon. This one has a C=O there.",
               "Glyceraldehyde-3-phosphate (G3P)":"G3P has a phosphate. This molecule has none." },
    hint1:"Three carbons, no phosphate. Look at the middle carbon: does it have a C=O or a C–OH?",
    hint2:"This 3-carbon molecule is what glycolysis ends with." }
];
function bonusState(){ S.bonus=S.bonus||{named:{},misses:{},revealed:[]}; return S.bonus; }
function buildBonus(){
  const grid=$("molGrid"); grid.innerHTML="";
  MOLS.forEach((m,i)=>{
    const d=document.createElement("div"); d.className="mol"; d.id="mol-"+m.id;
    d.innerHTML=`<div class="molimg"><img src="${IMGS[m.img].tray}" alt="Molecule ${i+1} structure"></div>
      <label for="molsel-${m.id}">Molecule ${i+1}</label>
      <select id="molsel-${m.id}"><option value="">Choose a name…</option>${MOL_OPTIONS.map(o=>`<option>${o}</option>`).join("")}</select>
      <p class="molfb" id="molfb-${m.id}" aria-live="polite"></p>`;
    grid.appendChild(d);
    d.querySelector("select").addEventListener("change",e=>checkMol(m,e.target.value));
  });
}
function refreshBonus(){
  if(!S) return; const B=bonusState();
  MOLS.forEach(m=>{
    const done=!!B.named[m.id], sel=$("molsel-"+m.id);
    $("mol-"+m.id).classList.toggle("ok",done);
    if(done){ sel.value=m.answer; sel.disabled=true; }
    else sel.disabled=false;
  });
  const n=MOLS.filter(m=>B.named[m.id]).length;
  $("bonusCount").textContent=`${n} of ${MOLS.length} named`;
  $("bonusBtn").textContent = n===MOLS.length ? "Bonus: molecules ✓" : (n? `Bonus: name the molecules (${n}/4)` : "Bonus: name the molecules");
}
function checkMol(m,val){
  if(!val) return; const B=bonusState(), fb=$("molfb-"+m.id);
  if(val===m.answer){ B.named[m.id]=true; fb.className="molfb ok"; fb.textContent=m.ok; }
  else{
    const n=(B.misses[m.id]||0)+1; B.misses[m.id]=n;
    fb.className="molfb warn";
    if(n>=3){ B.named[m.id]=true; B.revealed.push(m.id); fb.textContent=`This is ${m.answer.replace(/ \(G3P\)/," (G3P)")}. ${m.ok.replace(/^Yes\. /,"")}`; }
    else{ fb.textContent = (n===1 ? (m.specific[val]||m.hint1) : m.hint2); $("molsel-"+m.id).value=""; }
  }
  refreshBonus(); save();
}
function openBonus(){ $("doneOv").classList.add("hidden"); $("bonusOv").classList.remove("hidden"); refreshBonus(); }
$("bonusBtn").addEventListener("click",openBonus);
$("doneBonus").addEventListener("click",openBonus);
$("bonusClose").addEventListener("click",()=>$("bonusOv").classList.add("hidden"));
buildBonus();

</script>
</body>
