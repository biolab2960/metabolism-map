<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Where in the cell? · Bio 2960</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#00205B; --membrane:#2F5597; --sky:#29B6F6;
  --bg:#E9EEF5; --panel:#FFFFFF; --ink:#14213D; --muted:#55627A; --line:#C9D3E2;
  --ok:#1E7B34; --okbg:#E4F4E7; --warn:#A4361B; --warnbg:#FBE9E3; --info:#00205B; --infobg:#E6ECF7;
  --sticky:#FFE9A8; --stickyink:#3A2E00;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root{
    --navy:#A9C4FF; --bg:#0F1828; --panel:#18243A; --ink:#E6ECF7; --muted:#9AA8C2; --line:#2E3D58;
    --ok:#8FDB9F; --okbg:#173525; --warn:#FFB59E; --warnbg:#3B1D15; --info:#C8D7FF; --infobg:#1E2D4B;
    --sticky:#5A4A12; --stickyink:#FFF1C2;
    color-scheme: dark;
  }
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:"Atkinson Hyperlegible",system-ui,sans-serif;font-size:17px;line-height:1.45}
button,select,input{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--sky);outline-offset:2px}
.hidden{display:none !important}

/* header */
header{display:flex;align-items:center;gap:20px;flex-wrap:wrap;padding:14px 22px;background:var(--panel);border-bottom:1px solid var(--line)}
header h1{margin:0;font-size:1.35rem;letter-spacing:-.01em;color:var(--navy)}
.steps{display:flex;gap:6px;margin:0;padding:0;list-style:none}
.steps li{padding:5px 12px;border-radius:999px;border:1.5px solid var(--line);color:var(--muted);font-size:.9rem}
.steps li.now{border-color:var(--navy);color:var(--navy);font-weight:700}
.steps li.done{border-color:var(--ok);color:var(--ok)}
.meta{margin-left:auto;display:flex;gap:14px;align-items:center;font-size:.95rem;color:var(--muted)}
.meta b{color:var(--ink)}
.timer.late{color:var(--warn)}
.linkbtn{background:none;border:none;color:var(--navy);text-decoration:underline;cursor:pointer;padding:2px}

/* layout */
main{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:18px;padding:18px 22px;max-width:1400px;margin:0 auto}
@media (max-width:900px){main{grid-template-columns:minmax(0,1fr);padding:12px}.board{position:static}.steps li{font-size:.8rem;padding:4px 9px}header{padding:12px}}
.board{position:sticky;top:12px;align-self:start;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px}
svg#cell{width:100%;height:auto;display:block;touch-action:none;user-select:none}
.rg{cursor:pointer;transition:filter .12s}
.rg:hover{filter:brightness(1.12) saturate(1.1)}
.rg.hl{fill:#4FC3F7 !important}
.rg.flash{animation:flash .6s 2}
@keyframes flash{50%{filter:brightness(1.6)}}
@media (prefers-reduced-motion:reduce){.rg.flash{animation:none}}
#tip{position:fixed;pointer-events:none;background:#00205B;color:#fff;padding:3px 9px;border-radius:6px;font-size:.85rem;z-index:20;white-space:nowrap}

.boardhint{margin:2px 4px 10px;font-weight:700;color:var(--navy);font-size:1.05rem}
.feedback{margin:0;padding:12px 16px;border-radius:10px;border-left:6px solid var(--info);background:var(--infobg);min-height:56px}
.feedback.ok{border-color:var(--ok);background:var(--okbg)}
.feedback.warn{border-color:var(--warn);background:var(--warnbg)}
.feedback p{margin:0}
.feedback p+p{margin-top:6px}

/* tray */
aside{display:flex;flex-direction:column;gap:12px}
.panelhead{margin:0;font-size:1.05rem}
.panelnote{margin:0;color:var(--muted);font-size:.92rem}
.tray{display:flex;flex-direction:column;gap:10px}
@media (max-width:900px){.tray{flex-direction:row;overflow-x:auto;padding-bottom:6px}.card{min-width:240px}}
.card{background:var(--panel);border:2px solid var(--line);border-radius:12px;padding:10px;position:relative}
.card.sel{border-color:var(--sky);box-shadow:0 0 0 3px rgba(41,182,246,.3)}
.card.placed{border-color:var(--ok)}
.card .grab{display:block;width:100%;background:#fff;border:none;border-radius:8px;padding:6px;cursor:grab;touch-action:none}
.card .grab img{display:block;max-width:100%;max-height:150px;margin:0 auto;pointer-events:none}
.card.placed .grab{cursor:default;opacity:.55}
.card.tall .grab img{max-height:240px}
.cardrow{display:flex;align-items:center;justify-content:space-between;margin-top:8px;gap:8px;font-size:.92rem}
.cardrow .t{font-weight:700}
.cardrow .s{color:var(--muted)}
.card.placed .s{color:var(--ok)}
.zoom{border:1.5px solid var(--line);background:transparent;border-radius:6px;padding:2px 8px;font-size:.85rem;cursor:pointer}
.namebox{margin-top:8px}
.namedline{margin:6px 0 0;font-size:.9rem;color:var(--ok);font-weight:700}
.card.complete{opacity:.8}
.namebox label{font-size:.88rem;color:var(--muted);display:block;margin-bottom:3px}
.namebox select{width:100%;padding:6px;border-radius:8px;border:1.5px solid var(--line);background:var(--panel)}
.ghost{position:fixed;z-index:30;pointer-events:none;background:#fff;border:2px solid var(--sky);border-radius:8px;padding:4px;box-shadow:0 8px 24px rgba(0,0,0,.25);transform:translate(-50%,-60%)}
.ghost img{display:block;max-width:150px;max-height:110px}

.sticky{background:var(--sticky);color:var(--stickyink);padding:16px 18px;border-radius:3px;transform:rotate(-1.2deg);box-shadow:2px 4px 10px rgba(0,0,0,.15);font-weight:700;font-size:1.05rem;line-height:1.35}
.sticky .mlabel{display:block;font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px;opacity:.8}
.sticky small{display:block;font-weight:400;margin-top:6px;font-size:.88rem}
.primary{background:var(--navy);color:var(--panel);border:none;border-radius:10px;padding:10px 18px;font-weight:700;cursor:pointer}
@media (prefers-color-scheme: dark){.primary{color:#0F1828}}
.primary:disabled{opacity:.45;cursor:not-allowed}
.secondary{background:transparent;border:1.5px solid var(--line);border-radius:10px;padding:9px 16px;cursor:pointer}

/* overlays */
.overlay{position:fixed;inset:0;background:rgba(0,20,50,.55);display:flex;align-items:center;justify-content:center;z-index:40;padding:16px}
.dialog{background:var(--panel);border-radius:16px;padding:26px 28px;max-width:520px;width:100%;max-height:92vh;overflow:auto}
.dialog.wide{max-width:980px}
.dialog h2{margin:0 0 6px;color:var(--navy);font-size:1.5rem}
.dialog p{margin:0 0 14px}
.field{margin-bottom:14px}
.field label{display:block;font-weight:700;margin-bottom:4px}
.field select,.field input{width:100%;padding:9px;border-radius:8px;border:1.5px solid var(--line);background:var(--panel)}
.fine{font-size:.85rem;color:var(--muted)}
.btnrow{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:6px}
.zoomimg{max-width:100%;max-height:75vh;display:block;margin:0 auto;background:#fff;border-radius:8px}

/* dashboard */
table{width:100%;border-collapse:collapse;font-size:.95rem}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line)}
th{color:var(--muted);font-weight:700}
.bar{height:8px;border-radius:4px;background:var(--line);overflow:hidden;min-width:80px}
.bar i{display:block;height:100%;background:var(--ok)}
.pill{display:inline-block;padding:1px 9px;border-radius:999px;font-size:.85rem;border:1.5px solid var(--line)}
.pill.ok{border-color:var(--ok);color:var(--ok)}
.trouble{margin:16px 0 0;padding-left:18px}

.tools{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:0 4px 8px}
.tools button{border:1.5px solid var(--line);background:transparent;border-radius:8px;padding:4px 11px;font-size:.92rem;cursor:pointer}
.tools button:hover{border-color:var(--navy)}
.tools button.primary{background:var(--navy);border-color:var(--navy);color:var(--panel);font-weight:700}
.toolslabel{font-weight:700;margin-right:4px}
.pc{cursor:grab}
.pc.locked{cursor:default}
.pcbox{fill:transparent;stroke:none}
.pc.sel .pcbox{stroke:#29B6F6;stroke-width:2.5;stroke-dasharray:6 4}
.anchor{fill:#E53935;stroke:#fff;stroke-width:1.2}
.handleline{stroke:#29B6F6;stroke-width:2}
.handle{fill:#29B6F6;stroke:#fff;stroke-width:2;cursor:grab}
.handleicon{font-size:13px;fill:#fff;pointer-events:none;font-weight:700}
.tag{fill:#fff;stroke:#00205B;stroke-width:2}
.tag.done{stroke:#1E7B34}
.tagtext{font-size:12.5px;font-weight:700;fill:#00205B;font-family:"Atkinson Hyperlegible",system-ui,sans-serif;pointer-events:none}
.molgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
@media (max-width:900px){.molgrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.mol{border:2px solid var(--line);border-radius:12px;padding:10px;display:flex;flex-direction:column;gap:6px}
.mol.ok{border-color:var(--ok)}
.molimg{background:#fff;border-radius:8px;padding:8px;display:flex;align-items:center;justify-content:center;height:170px}
.molimg img{max-width:100%;max-height:100%}
.mol label{font-weight:700;font-size:.95rem}
.mol select{width:100%;padding:7px;border-radius:8px;border:1.5px solid var(--line);background:var(--panel);font-size:.92rem}
.molfb{margin:0;font-size:.9rem;line-height:1.35}
.molfb.ok{color:var(--ok)}
.molfb.warn{color:var(--warn)}
</style>
</head>
<body>

<header>
  <h1>Where in the cell?</h1>
  <ol class="steps" id="steps">
    <li id="st1">Place 0/5</li>
    <li id="st2">Name 0/5</li>
    <li id="st3">Mission</li>
  </ol>
  <div class="meta">
    <span id="who"></span>
    <span id="sync" class="hidden" style="color:var(--warn)" title="Progress isn't reaching the instructor sheet. The game still works.">⚠ Not syncing</span>
    <span class="timer" id="timer">0:00</span>
    <button class="linkbtn" id="openDash">Instructor view</button>
  </div>
</header>

<main>
  <section class="board" aria-label="Plant cell">
    <p class="boardhint" id="boardHint">Drag each card from the right onto the part of the cell where that process happens.</p>
    <div class="tools hidden" id="tools" role="toolbar" aria-label="Selected card">
      <span class="toolslabel" id="toolsLabel"></span>
      <button id="tLeft" title="Rotate left 15° (Shift+R)">↺ 15°</button>
      <button id="tRight" title="Rotate right 15° (R)">↻ 15°</button>
      <button id="tFlip" title="Rotate 180°">Flip</button>
      <button id="tCheck" class="primary small">Check orientation</button>
      <button id="tBack">Back to tray</button>
    </div>
    <svg id="cell" viewBox="0 0 1000 620" role="img" aria-label="Plant cell with a chloroplast and a mitochondrion"></svg>
  </section>

  <aside>
    <div class="feedback" id="feedback" aria-live="polite"><p>Each card shows one process from photosynthesis or cellular respiration. Drag it onto the place in the cell where that process happens. Hover over the cell to see what each part is called.</p><p>For the two electron transport chains, the red dot marks the membrane proteins. Put it on the right membrane and rotate the card so each side faces the right compartment.</p></div>
    <div id="placePanel">
      <h2 class="panelhead">Process cards</h2>
      <p class="panelnote">Place and name all five cards, in any order.</p>
    </div>
    <div class="tray" id="tray"></div>
    <div id="postitPanel" class="hidden">
      <h2 class="panelhead" style="margin-bottom:10px">Your mission</h2>
      <div class="sticky" id="stickyText"></div>
      <p class="panelnote" style="margin:14px 0 10px">Tap every part of the cell that fits. Tap again to unshade it.</p>
      <div class="btnrow"><button class="primary" id="checkHl">Check my mission</button><button class="secondary" id="clearHl">Clear</button></div>
      <button class="secondary hidden" id="bonusBtn" style="margin-top:16px;width:100%">Bonus: name the molecules</button>
    </div>
  </aside>
</main>

<div id="tip" class="hidden"></div>

<!-- start -->
<div class="overlay" id="startOv">
  <div class="dialog">
    <h2>Where in the cell?</h2>
    <p>Drag each step of photosynthesis and cellular respiration to where it happens in a plant cell, name each one, then complete a final mission. About 5 minutes.</p>
    <div class="field"><label for="secSel">Section</label><select id="secSel"></select></div>
    <div class="field"><label for="grpIn">Group name</label><input id="grpIn" maxlength="24" placeholder="For example, Table 3" autocomplete="off"></div>
    <div class="field"><label for="featSel">Your mission</label><select id="featSel"></select>
      <div class="fine" style="margin-top:4px">Use the one your instructor gives you, or pick any.</div></div>
    <div class="btnrow"><button class="primary" id="startBtn">Start</button><span class="fine" id="resumeNote"></span></div>
    <p class="fine" style="margin-top:16px">Your group's progress is saved to your instructor's sheet so they can follow along, and anyone with this link can open the instructor view. Don't enter student names.</p>
  </div>
</div>

<!-- zoom -->
<div class="overlay hidden" id="zoomOv">
  <div class="dialog wide">
    <img class="zoomimg" id="zoomImg" alt="">
    <div class="btnrow" style="justify-content:flex-end;margin-top:14px"><button class="primary" id="zoomClose">Close</button></div>
  </div>
</div>

<!-- done -->
<div class="overlay hidden" id="doneOv">
  <div class="dialog">
    <h2>Board complete</h2>
    <p id="doneText"></p>
    <p>Be ready to explain one placement and your mission to the class.</p>
    <div class="btnrow"><button class="primary" id="doneBonus">Try the bonus: name 4 molecules</button><button class="secondary" id="doneClose">Review my board</button></div>
  </div>
</div>

<!-- bonus -->
<div class="overlay hidden" id="bonusOv">
  <div class="dialog wide">
    <h2>Bonus: name the molecules</h2>
    <p>These four molecules show up in the pathways on your board. Choose a name for each one.</p>
    <div class="molgrid" id="molGrid"></div>
    <div class="btnrow" style="justify-content:space-between;margin-top:16px"><span class="fine" id="bonusCount"></span><button class="primary" id="bonusClose">Done</button></div>
  </div>
</div>

<!-- dashboard -->
<div class="overlay hidden" id="dashOv">
  <div class="dialog wide">
    <h2>Instructor view</h2>
    <div class="btnrow" style="margin-bottom:12px">
      <select id="dashSec" style="padding:7px;border-radius:8px;border:1.5px solid var(--line);background:var(--panel)"></select>
      <span class="fine" id="dashStamp"></span>
    </div>
    <div id="dashBody"><p class="fine">Loading…</p></div>
    <div class="btnrow" style="justify-content:space-between;margin-top:18px">
      <button class="secondary" id="dashClear">Clear this section's data</button>
      <button class="primary" id="dashClose">Close</button>
    </div>
  </div>
</div>

